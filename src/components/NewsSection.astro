---
import SectionHeading from "./SectionHeading.astro";
import { getNewsItems } from "../lib/content";

const homepageNews = (await getNewsItems()).slice(0, 3);
---

<section aria-labelledby="news-title" class="manual-section" id="news">
  <SectionHeading id="news-title" title="News" page="05" link={{ href: "/news/", label: "All news" }} />
  <div class="news-cards">
    {homepageNews.map((item) => (
      <article class="news-card notch"><time datetime={item.date}>{item.displayDate}</time><h3>{item.title}</h3><p>{item.summary}</p></article>
    ))}
  </div>
</section>
