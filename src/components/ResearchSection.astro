---
import AreaMarker from "./AreaMarker.astro";
import SectionHeading from "./SectionHeading.astro";
import { getResearchAreas } from "../lib/content";

const researchAreas = await getResearchAreas();
---

<section aria-labelledby="research-title" class="manual-section" id="research">
  <SectionHeading id="research-title" title="Research areas" page="01" link={{ href: "/research/", label: "All research" }} />
  <div class="area-cards">
    {researchAreas.map((area) => (
      <a class="area-card notch" href={`/research/#${area.id}`}>
        <AreaMarker marker={area.marker} size="large" />
        <h3>{area.title}</h3>
        <p>{area.description}</p>
      </a>
    ))}
  </div>
</section>
