---
import SectionHeading from "./SectionHeading.astro";
import { getPeople } from "../lib/content";

const people = await getPeople();
const members = people.filter((person) => (person.role === "Co-director" || person.studentStatus === "current") && person.featured);
---

<section aria-labelledby="people-title" class="manual-section" id="people">
  <SectionHeading id="people-title" title="People" page="04" link={{ href: "/people/", label: "All people" }} />
  <ul class="people-strip">
    {members.map((person) => (
      <li>
        {person.photo ? <img src={person.photo} alt="" width="240" height="320" loading="lazy" decoding="async" /> : <span class="people-initials" aria-hidden="true">{person.initials}</span>}
        <b>{person.personalWebsite ? <a href={person.personalWebsite} rel="noopener noreferrer" target="_blank">{person.name}</a> : person.name}</b>
        <span class={person.role === "Co-director" ? "people-role director" : "people-role"}>{person.role}</span>
      </li>
    ))}
  </ul>
</section>
