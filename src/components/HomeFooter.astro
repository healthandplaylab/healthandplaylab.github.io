---
import { getSiteSettings } from "../lib/content";

const siteSettings = await getSiteSettings();
const affiliation = siteSettings.institutionalAffiliation;
---

<footer class="manual-footer">
  <div>
    <b>{siteSettings.labName}</b>
    <p>{affiliation.address}<br />{affiliation.college} · {affiliation.institution}</p>
  </div>
  <div class="manual-footer-meta">
    <a href="#top">Back to top</a>
    <span>Last saved: {siteSettings.lastSubstantiveContentUpdateDisplay}</span>
    <span class="footer-rights">© 2026 Health and Play Lab. Site design by Xinning Gui; please do not reuse without permission.</span>
  </div>
</footer>
