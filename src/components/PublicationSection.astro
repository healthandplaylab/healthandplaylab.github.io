---
import PubList from "./PubList.astro";
import SectionHeading from "./SectionHeading.astro";
import { getPublications, recentPapers } from "../lib/content";

const homepagePublications = recentPapers(await getPublications(), 5);
---

<section aria-labelledby="publications-title" class="manual-section" id="publications">
  <SectionHeading id="publications-title" title="Recent publications" page="03" link={{ href: "/publications/", label: "All publications" }} />
  <PubList publications={homepagePublications} />
</section>
