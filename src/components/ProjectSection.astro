---
import AreaMarker from "./AreaMarker.astro";
import SectionHeading from "./SectionHeading.astro";
import { getProjects, getResearchAreas } from "../lib/content";

const projects = (await getProjects()).filter((project) => project.featured);
const areas = await getResearchAreas();
const markerFor = (id: string) => areas.find((area) => area.id === id)?.marker ?? "filled";
const bandText = (project: (typeof projects)[number]) =>
  [project.years, project.funding?.funder === "National Science Foundation" ? "NSF" : null].filter(Boolean).join(" · ") || project.label;
---

<section aria-labelledby="work-title" class="manual-section" id="projects">
  <SectionHeading id="work-title" title="Current projects" page="02" />
  <div class="cartridges">
    {projects.map((project) => (
      <a class={`cartridge band-${markerFor(project.researchArea.id)}`} href={`/research/${project.id}/`}>
        <span class="cartridge-band"><span>{bandText(project)}</span><AreaMarker marker={markerFor(project.researchArea.id)} /></span>
        <span class="cartridge-body"><h3>{project.title}</h3><p>{project.description}</p></span>
      </a>
    ))}
  </div>
</section>
