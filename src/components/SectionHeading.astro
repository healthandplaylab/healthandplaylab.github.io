---
// Section heading: the lab's controller mark, the title, and an optional link.
interface Props {
  id: string;
  title: string;
  page?: string;
  link?: { href: string; label: string };
  level?: "h2" | "h3";
}
const { id, title, page, link, level = "h2" } = Astro.props;
const Heading = level;
---

<div class="manual-heading">
  {page && <img class="manual-mark" src="/images/logo-mark.svg" alt="" width="34" height="30" />}
  <Heading id={id}>{title}</Heading>
  <span class="manual-rule" aria-hidden="true"></span>
  {link && <a class="manual-link" href={link.href}>{link.label}</a>}
</div>
