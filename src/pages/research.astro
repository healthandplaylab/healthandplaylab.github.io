---
import BaseLayout from "../layouts/BaseLayout.astro";
import SimpleHeader from "../components/SimpleHeader.astro";
import SimpleFooter from "../components/SimpleFooter.astro";
import InteriorHero from "../components/InteriorHero.astro";
import AreaMarker from "../components/AreaMarker.astro";
import { getProjects, getPublications, getResearchAreas, getSiteSettings } from "../lib/content";

const siteSettings = await getSiteSettings();
const areas = await getResearchAreas();
const projects = await getProjects();
const publications = await getPublications();
const examplesFor = (project: (typeof projects)[number]) =>
  project.relatedPublications
    .map((ref) => publications.find((publication) => publication.id === ref.id))
    .filter((publication) => publication !== undefined)
    .slice(0, 2);
const shortTitle = (title: string) => title.split(/: (?=[A-Z])/)[0];
---

<BaseLayout title={`Research — ${siteSettings.labName}`} bodyClass="v8-page interior-page research-page">
  <SimpleHeader current="research" />
  <main id="main">
    <InteriorHero
      title="Research"
      intro="Our research brings together work on health technologies, digital play, and the experiences of people who use them. The three areas below reflect related lines of inquiry across the lab."
    />
    <nav class="area-select" aria-label="Research areas">
      <span class="area-select-label" aria-hidden="true">SELECT AN AREA</span>
      {areas.map((area) => <a href={`#${area.id}`}><AreaMarker marker={area.marker} />{area.title}</a>)}
    </nav>
    {areas.map((area) => {
      const areaProjects = projects.filter((project) => project.researchArea.id === area.id);
      return (
        <section class="research-area" id={area.id} aria-labelledby={`${area.id}-title`}>
          <div class="research-area-head">
            <div class="research-area-mark"><AreaMarker marker={area.marker} size="large" /><span aria-hidden="true">{area.displayNumber}</span></div>
            <div><h2 id={`${area.id}-title`}>{area.title}</h2><p class="research-area-topics">{area.topics}</p></div>
            <p class="research-area-desc">{area.description}</p>
          </div>
          <div class:list={["research-area-projects", { single: areaProjects.length === 1 }]}>
            {areaProjects.map((project) => (
              <a class={`cartridge band-${area.marker}`} href={`/research/${project.id}/`}>
                <span class="cartridge-band"><span>{[project.years, project.funding?.awardNumber ? `NSF #${project.funding.awardNumber}` : null].filter(Boolean).join(" · ") || project.label}</span><AreaMarker marker={area.marker} /></span>
                <span class="cartridge-body">
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                  {examplesFor(project).length > 0 && (
                    <span class="cartridge-papers">
                      <span class="cartridge-papers-label">Example papers</span>
                      {examplesFor(project).map((publication) => <span class="cartridge-paper">{shortTitle(publication.title)} <span class="cartridge-venue">· {publication.venue} {publication.year}{publication.award ? " ★" : ""}</span></span>)}
                    </span>
                  )}
                  <span class="cartridge-more">Project details</span>
                </span>
              </a>
            ))}
          </div>
        </section>
      );
    })}
  </main>
  <SimpleFooter backLink />
</BaseLayout>
