---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHeader from "../components/HomeHeader.astro";
import Controller from "../components/Controller.astro";
import ResearchSection from "../components/ResearchSection.astro";
import ProjectSection from "../components/ProjectSection.astro";
import PublicationSection from "../components/PublicationSection.astro";
import PeopleSection from "../components/PeopleSection.astro";
import NewsSection from "../components/NewsSection.astro";
import HomeFooter from "../components/HomeFooter.astro";
import { getSiteSettings } from "../lib/content";

const siteSettings = await getSiteSettings();
const pixels = "ffnnoonnnnnfcoooonnnnnnoowonnn".split("");
---

<BaseLayout title={siteSettings.labName} bodyClass="v8-page home-page">
  <HomeHeader />
  <main id="main">
    <section aria-labelledby="hero-heading" class="manual-hero">
      <div class="hero-text">
        <p class="hero-kicker">The Health and Play Lab · Penn State IST</p>
        <h1 id="hero-heading"><span class="hero-health">Health</span> and <span class="hero-play">play</span> are fundamental human values.</h1>
        <p class="hero-copy">At the Health and Play Lab, we study how digital technologies support—and sometimes undermine—health, wellbeing, and play. Our research examines how people experience health technologies, AI systems, games, and online communities, and how their design and governance shape privacy, safety, accountability, and participation.</p>
        <div class="pixel-field" aria-hidden="true">{pixels.map((cell) => <span class={`px-${cell}`}></span>)}</div>
      </div>
      <Controller />
    </section>
    <ResearchSection />
    <ProjectSection />
    <PublicationSection />
    <PeopleSection />
    <NewsSection />
    <section aria-labelledby="join-title" class="manual-join" id="join">
      <div>
        <p class="manual-join-kicker">New player guide</p>
        <h2 id="join-title">Join the lab</h2>
        <p>How prospective Ph.D., master’s, and undergraduate students can get involved.</p>
      </div>
      <a class="pill-button" href={siteSettings.contactInformation.joinPage}>Select your path</a>
    </section>
  </main>
  <HomeFooter />
</BaseLayout>
