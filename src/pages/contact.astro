---
import BaseLayout from "../layouts/BaseLayout.astro";
import SimpleHeader from "../components/SimpleHeader.astro";
import SimpleFooter from "../components/SimpleFooter.astro";
import InteriorHero from "../components/InteriorHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import JoinGuide from "../components/JoinGuide.astro";
import { getSiteSettings } from "../lib/content";

const siteSettings = await getSiteSettings();
const affiliation = siteSettings.institutionalAffiliation;
---

<BaseLayout title={`Contact Us — ${siteSettings.labName}`} bodyClass="v8-page interior-page contact-page">
  <SimpleHeader current="contact" />
  <main id="main">
    <InteriorHero title="Contact us" />
    <section class="contact-section" aria-labelledby="contact-title">
      <div class="page-shell">
        <SectionHeading id="contact-title" title="Get in touch" page="01" />
        <p class="contact-intro">For questions about our research, media inquiries, collaborations, or invitations, please email Xinning Gui or Yubo Kou.</p>
        <div class="contact-cards">
          {siteSettings.contactInformation.directors.map((contact) => (
            <div class="contact-card">
              <p class="contact-label">Co-director</p>
              <h3>{contact.name}</h3>
              <a href={`mailto:${contact.email}`}>{contact.email}</a>
            </div>
          ))}
          <div class="contact-card">
            <p class="contact-label">Address</p>
            <h3>{siteSettings.labName}</h3>
            <address>{affiliation.address.split(" · ").map((line) => <span>{line}</span>)}<span>{affiliation.college}</span><span>{affiliation.institution}</span></address>
          </div>
        </div>
      </div>
    </section>
    <section class="contact-section join-section" id="join" aria-labelledby="join-title">
      <div class="page-shell">
        <SectionHeading id="join-title" title="Join the lab" page="02" />
        <JoinGuide />
      </div>
    </section>
  </main>
  <SimpleFooter backLink />
</BaseLayout>
